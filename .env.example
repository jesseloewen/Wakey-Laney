# This file is read automatically from .env by python-dotenv at app startup.
# Copy this to .env and adjust values for your network.

# Web server settings
APP_HOST=0.0.0.0
APP_PORT=7448

# Optional: allow API calls from web pages on other origins.
# Use * for any origin, or set a specific origin like https://example.com.
CORS_ALLOW_ORIGIN=*

# Device storage file path. Relative paths are resolved from the source directory.
# Default value below creates/uses ./devices.json next to app.py.
DEVICES_FILE=devices.json

# Optional ping timeout in milliseconds.
PING_TIMEOUT_MS=1200

# Optional secret used to sign remember-password cookies.
# Set this to a long random value to keep cookie signatures unique to your app.
REMEMBER_COOKIE_SECRET=
